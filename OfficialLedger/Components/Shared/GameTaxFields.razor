@using OfficialLedger.Models

<details class="tax-fields form-field-full">
    <summary>Tax &amp; travel details <span>Optional now · useful at tax time</span></summary>
    <div class="form-grid">
        <div class="form-field"><label for="taxPayer">Payer / organization</label>
            <InputText id="taxPayer" @bind-Value="Model.PayerName" class="form-input" maxlength="200" disabled="ReadOnly" /></div>
        <div class="form-field"><label for="taxIncomeKind">Income type</label>
            <InputSelect id="taxIncomeKind" @bind-Value="Model.IncomeKind" class="form-input" disabled="ReadOnly">
                @foreach (var kind in TaxRecordLabels.IncomeKinds) { <option value="@kind">@TaxRecordLabels.Income(kind)</option> }
            </InputSelect></div>
        <div class="form-field"><label for="taxPaidDate">Date full payment received / available</label>
            <InputDate id="taxPaidDate" @bind-Value="Model.PaidDate" class="form-input" disabled="@(ReadOnly || !Model.IsPaid)" />
            <small>Mark the game paid to record this date. Leave unknown dates blank for review.</small></div>
        <div class="form-field"><label for="taxReimbursement">Travel reimbursement with game payment</label>
            <InputNumber id="taxReimbursement" @bind-Value="Model.TravelReimbursement" class="form-input" min="0" step="0.01" disabled="ReadOnly" />
            <ValidationMessage For="() => Model.TravelReimbursement" /></div>
        <div class="form-field"><label for="taxTravelDate">Trip date</label>
            <InputDate id="taxTravelDate" @bind-Value="Model.TravelDate" class="form-input" disabled="ReadOnly" /></div>
        <div class="form-field"><label for="taxMileageKind">Trip classification</label>
            <InputSelect id="taxMileageKind" @bind-Value="Model.MileageKind" class="form-input" disabled="ReadOnly">
                @foreach (var kind in TaxRecordLabels.MileageKinds) { <option value="@kind">@TaxRecordLabels.Mileage(kind)</option> }
            </InputSelect></div>
        <div class="form-field"><label for="taxOrigin">Trip origin / route</label>
            <InputText id="taxOrigin" @bind-Value="Model.TravelOrigin" class="form-input" maxlength="200" disabled="ReadOnly" /></div>
        <div class="form-field"><label for="taxPurpose">Reason for travel</label>
            <InputText id="taxPurpose" @bind-Value="Model.TravelPurpose" class="form-input" maxlength="500" disabled="ReadOnly" /></div>
    </div>
    <p>Log each trip's miles once, including days with multiple games. Describe split payments, refunds, or reimbursements paid on other dates in Notes for your preparer.</p>
</details>

@code {
    [Parameter, EditorRequired] public GameTaxInputModel Model { get; set; } = null!;
    [Parameter] public bool ReadOnly { get; set; }
}
