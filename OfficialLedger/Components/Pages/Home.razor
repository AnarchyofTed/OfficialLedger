@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@using OfficialLedger.Data
@using OfficialLedger.Models

@inject ApplicationDbContext Db
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>


<section class="dashboard-page">
    <header class="page-header dashboard-header">
        <div>
            <p class="page-kicker">Season command center</p>
            <h1 class="page-title">Welcome Back, @UserName</h1>
            <p class="page-subtitle">@selectedSeasonDateRange</p>
        </div>

        <div class="dashboard-header-actions">
            <button type="button" class="primary-btn dashboard-add-game" @onclick="GoToAddGame">Add game <span>+</span></button>
            <div class="season-picker">
                <button type="button" class="season-btn" @onclick="ToggleSeasonMenu"><img class="season-sport-image" src="@SeasonImages.Path(selectedSeasonImage)" alt="" /> @selectedSeasonName <span>⌄</span></button>

                @if (isSeasonMenuOpen)
                {
                    <div class="season-menu">
                        @if (!seasons.Any())
                        {
                            <div class="season-option-empty">No seasons available.</div>
                        }
                        else
                        {
                            @foreach (var season in seasons)
                            {
                                <button type="button" class="season-option" @onclick="() => SelectSeason(season)"><img class="season-sport-image" src="@SeasonImages.Path(season.SportImage)" alt="" /> @season.Name</button>
                            }
                        }
                    @if (selectedSeason is not null && selectedSeason.UserId == userId && !string.IsNullOrWhiteSpace(userId))
                    {
                        <button type="button" class="season-option" @onclick="GoToEditSeason">Edit Season</button>
                    }
                    <button type="button" class="season-option season-option-add" @onclick="GoToAddSeason">+ Add Season</button>
                    </div>
                }
            </div>
        </div>
    </header>
</section>

<section class="dashboard-metrics">
    <article class="metric-card">
        <span class="metric-icon" aria-hidden="true">$</span>
        <p class="metric-label">Total Earnings</p>
        <p class="metric-value">@totalEarnings.ToString("C")</p>
        <p class="metric-subtext">@totalGames @(totalGames == 1 ? "game" : "games")</p>
    </article>

    <article class="metric-card">
        <span class="metric-icon metric-icon-warn" aria-hidden="true">!</span>
        <p class="metric-label">Outstanding Pay</p>
        <p class="metric-value metric-value-outstanding">@outstandingPayAmount.ToString("C")</p>
        <p class="metric-subtext">@unpaidGames @(unpaidGames == 1 ? "game" : "games")</p>
    </article>
    <article class="metric-card">
        <span class="metric-icon" aria-hidden="true">↗</span>
        <p class="metric-label">Miles Driven</p>
        <p class="metric-value metric-value-neutral">
            @totalMilesDriven.ToString("N0")
            <span class="metric-value-unit">Mi</span>
        </p>
        <p class="metric-subtext">Across @totalGames @(totalGames == 1 ? "game" : "games")</p>
    </article>
</section>

<section class="attention-card">
    <div class="attention-card-header">
        <p class="page-kicker">Stay on top of the season</p>
        <h2>What Needs Attention</h2>
        <p>Track unpaid games and review your most recent assignments.</p>
    </div>

    <div class="attention-card-grid">
        <div class="attention-card-slot" aria-label="Who Still Owes Me card">
            <div class="attention-card-header">
                <h2>Who Still Owes Me</h2>
            </div>
            <div>
                <p class="metric-value-outstanding">@outstandingPayAmount.ToString("C")</p>
            </div>

            @if (!unpaidGamesList.Any())
            {
                <p class="owes-empty-state">No unpaid games in this season.</p>
            }
            else
            {
                <ul class="owes-list">
                    @foreach (var row in unpaidGamesList)
                    {
                        <li class="owes-list-item">
                            <div class="owes-list-main">
                                <p class="owes-list-name">@row.LocationName</p>
                                <p class="owes-list-details">@row.GameDate.ToString("MMM d, yyyy") • @row.TotalAmount.ToString("C")</p>
                            </div>
                            <button type="button" class="owes-mark-paid-btn" @onclick="() => MarkGameAsPaidAsync(row.GameIds)">
                                Mark as Paid
                            </button>
                        </li>
                    }
                </ul>
            }

            <button type="button" class="owes-see-all-btn" @onclick="GoToGames">See all</button>
        </div>
        <div class="attention-card-slot" aria-label="Recent Games card">
            <div class="recent-games-header">
                <h3>Recent Games</h3>
            </div>

            @if (!recentGames.Any())
            {
                <p class="owes-empty-state">No games in this season yet.</p>
            }
            else
            {
                <div class="recent-games-table">
                    <div class="recent-games-table-header">
                        <span>Last 5 Games</span>
                        <span>Earnings</span>
                        <span>Status</span>
                    </div>

                    <ul class="recent-games-list">
                        @foreach (var row in recentGames)
                        {
                            <li class="recent-games-row">
                                <p class="recent-games-date">@row.GameDate.ToString("M/d")</p>
                                <p class="recent-games-name"> @row.LocationName</p>
                                <p class="recent-games-earnings">@row.Earnings.ToString("C0")</p>
                                <span class="recent-games-status @(row.IsPaid ? "paid" : "unpaid")">
                                    @(row.IsPaid ? "Paid" : "Unpaid")
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <button type="button" class="owes-see-all-btn" @onclick="GoToGames">View All Games</button>
        </div>
    </div>
</section>

@code {
    private List<Season> seasons = new();
    private bool isSeasonMenuOpen;
    private string selectedSeasonName = "Select a season";
    private string selectedSeasonImage = "baseball";
    private Season? selectedSeason;

    [SupplyParameterFromQuery]
    public int? SeasonId { get; set; }
    private string selectedSeasonDateRange = "Welcome to Blue Ledger.";
    private decimal totalEarnings;
    private decimal totalMilesDriven;
    private int totalGames;
    private decimal outstandingPayAmount;
    private int unpaidGames;
    private List<UnpaidGameGroupRow> unpaidGamesList = new();
    private List<RecentGameRow> recentGames = new();
    private string? userId;

    private void ToggleSeasonMenu()
    {
        isSeasonMenuOpen = !isSeasonMenuOpen;
    }

    private async Task SelectSeason(Season season)
    {
        selectedSeason = season;
        selectedSeasonImage = season.SportImage;
        selectedSeasonName = season.Name;
        selectedSeasonDateRange = FormatSeasonDateRange(season);
        isSeasonMenuOpen = false;
        await LoadTotalEarningsAsync();
    }

    private static string FormatSeasonDateRange(Season season)
    {
        if (season.StartDate.Year == season.EndDate.Year)
        {
            return $"{season.StartDate:MMM d} - {season.EndDate:MMM d, yyyy}";
        }

        return $"{season.StartDate:MMM d, yyyy} - {season.EndDate:MMM d, yyyy}";
    }

    private string UserName = "User";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var name = authState.User.Identity?.Name ?? "User";
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        // Optional: remove email domain if present
        name = name.Split('@')[0];

        // Trim to max 20 characters
        if (name.Length > 20)
        {
            name = name.Substring(0, 20) + "...";
        }

        UserName = name;

        seasons = await Db.Seasons
            .Where(x => x.UserId == userId || x.UserId == null)
            .OrderByDescending(x => x.StartDate)
            .ToListAsync();

        if (seasons.Any())
        {
            selectedSeason = seasons.FirstOrDefault(x => x.Id == SeasonId)
                ?? seasons.FirstOrDefault(x => x.StartDate <= DateTime.Today && x.EndDate >= DateTime.Today)
                ?? seasons[0];
            selectedSeasonName = selectedSeason.Name;
            selectedSeasonImage = selectedSeason.SportImage;
            selectedSeasonDateRange = FormatSeasonDateRange(selectedSeason);
        }

        await LoadTotalEarningsAsync();
    }

    private async Task LoadTotalEarningsAsync()
    {
        if (string.IsNullOrWhiteSpace(userId))
        {
            totalEarnings = 0;
            totalMilesDriven = 0;
            totalGames = 0;
            outstandingPayAmount = 0;
            unpaidGames = 0;
            unpaidGamesList.Clear();
            recentGames.Clear();
            return;
        }

        var seasonId = selectedSeason?.Id;
        var start = selectedSeason?.StartDate.Date;
        var endExclusive = selectedSeason?.EndDate.Date.AddDays(1);
        var includeLegacyGames = selectedSeason is not null && selectedSeason.UserId is null;
        var query = Db.Games.Where(x => x.UserId == userId &&
            (x.SeasonId == seasonId ||
             (includeLegacyGames && x.SeasonId == null && x.GameDate >= start && x.GameDate < endExclusive)));
        if (selectedSeason is null)
        {
            query = Db.Games.Where(x => x.UserId == userId);
        }

        totalEarnings = await query.SumAsync(x => x.FeeAmount);
        totalMilesDriven = await query.SumAsync(x => x.MilesDriven);
        totalGames = await query.CountAsync();

        var unpaidQuery = query.Where(x => !x.IsPaid);
        outstandingPayAmount = await unpaidQuery.SumAsync(x => x.FeeAmount);
        unpaidGames = await unpaidQuery.CountAsync();

       var unpaidListToQuery = await unpaidQuery
            .OrderBy(x => x.GameDate)
            .ToListAsync();

        unpaidGamesList = unpaidListToQuery
            .GroupBy(x => new
            {
                GameDate = x.GameDate.Date,
                LocationName = x.LocationName.Trim()
            })
            .OrderBy(x => x.Key.GameDate)
            .ThenBy(x => x.Key.LocationName)
            .Select(x => new UnpaidGameGroupRow
            {
                GameDate = x.Key.GameDate,
                LocationName = x.Key.LocationName,
                TotalAmount = x.Sum(g => g.FeeAmount),
                GameIds = x.Select(g => g.Id).ToList()
            })
            .Take(3)
            .ToList();

        var today = DateTime.Today;

        recentGames = await query
            .Where(x => x.GameDate < today)
            .OrderByDescending(x => x.GameDate)
            .ThenByDescending(x => x.Id)
            .Select(x => new RecentGameRow
            {
                GameDate = x.GameDate,
                LocationName = x.LocationName,
                Earnings = x.FeeAmount,
                IsPaid = x.IsPaid
            })
            .Take(5)
            .ToListAsync();
    }

    private async Task MarkGameAsPaidAsync(List<int> gameIds)
    {
        if (!gameIds.Any())
        {
            return;
        }

        var games = await Db.Games
            .Where(x => x.UserId == userId && gameIds.Contains(x.Id))
            .ToListAsync();

        if (!games.Any())
        {
            return;
        }

        foreach (var game in games)
        {
            game.IsPaid = true;
        }

        await Db.SaveChangesAsync();
        await LoadTotalEarningsAsync();
    }

    private void GoToEditSeason()
    {
        if (selectedSeason is not null && selectedSeason.UserId == userId && !string.IsNullOrWhiteSpace(userId))
            NavigationManager.NavigateTo($"/edit-season/{selectedSeason.Id}");
    }

    private void GoToAddSeason() => NavigationManager.NavigateTo("/add-season");

    private void GoToGames()
    {
        NavigationManager.NavigateTo("/games");
    }

    private void GoToAddGame()
    {
        NavigationManager.NavigateTo(selectedSeason is null ? "/add-game" : $"/add-game?seasonId={selectedSeason.Id}");
    }

    private sealed class UnpaidGameGroupRow
    {
        public DateTime GameDate { get; set; }
        public string LocationName { get; set; } = string.Empty;
        public decimal TotalAmount { get; set; }
        public List<int> GameIds { get; set; } = new();
    }

    private sealed class RecentGameRow
    {
        public DateTime GameDate { get; set; }
        public string LocationName { get; set; } = string.Empty;
        public decimal Earnings { get; set; }
        public bool IsPaid { get; set; }
    }
}

