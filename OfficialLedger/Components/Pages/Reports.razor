@page "/reports"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OfficialLedger.Data
@using OfficialLedger.Models

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Reports</PageTitle>

<div class="page-content reports-page">
    <header class="page-header">
        <div>
            <p class="page-kicker">Ledger totals</p>
            <h1 class="page-title">Reports</h1>
            <p class="page-subtitle">A clean summary of the work, travel, and payments in your ledger.</p>
        </div>
        <select class="report-period report-filter" aria-label="Report scope" @bind="selectedFilter" @bind:after="ApplyFilter" disabled="@isLoading">
            <optgroup label="All Recorded Games">
                <option value="all">All Recorded Games</option>
            </optgroup>
            <optgroup label="By Year">
                @foreach (var year in years)
                {
                    <option value="@($"year:{year}")">@year</option>
                }
            </optgroup>
            <optgroup label="By Season">
                @foreach (var season in seasons)
                {
                    <option value="@($"season:{season.Id}")">@season.Name</option>
                }
            </optgroup>
        </select>
    </header>

    @if (isLoading)
    {
        <div class="loading-card">Building your season report...</div>
    }
    else if (totalGames == 0 && reportExpenses.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state-mark" aria-hidden="true">▥</span>
            <h2>@(selectedFilter == "all" ? "No report data yet." : "No records in this selection.")</h2>
            <p>@(selectedFilter == "all" ? "Your summaries will appear after you add a game or expense." : "Choose another year or season, or add a game or expense.")</p>
            <a class="add-game-btn" href="/add-game">Add a game</a>
        </div>
    }
    else
    {
        <section class="report-metrics">
            <article><span>Total earnings</span><strong>@totalEarnings.ToString("C0")</strong><small>Across @totalGames games</small></article>
            <article><span>Paid</span><strong>@paidEarnings.ToString("C0")</strong><small>@paidGames completed payments</small></article>
            <article class="report-outstanding"><span>Outstanding</span><strong>@outstandingEarnings.ToString("C0")</strong><small>@unpaidGames awaiting payment</small></article>
            <article><span>Miles logged</span><strong>@totalMiles.ToString("N0")</strong><small>Recorded travel</small></article>
        </section>

        <section class="report-grid">
            <article class="report-card report-payment-card">
                <div class="report-card-header"><div><p class="page-kicker">Payment health</p><h2>@paidRate.ToString("N0")% collected</h2></div><span>@paidGames / @totalGames</span></div>
                <div class="payment-progress" aria-label="@PaidProgressLabel"><i style="width: @(paidRate)%"></i></div>
                <div class="payment-legend"><span><i class="paid"></i>Paid <b>@paidEarnings.ToString("C0")</b></span><span><i class="unpaid"></i>Outstanding <b>@outstandingEarnings.ToString("C0")</b></span></div>
            </article>

            <article class="report-card">
                <div class="report-card-header"><div><p class="page-kicker">Game mix</p><h2>By sport</h2></div><span>@sportSummaries.Count sports</span></div>
                <div class="sport-breakdown">
                    @foreach (var sport in sportSummaries)
                    {
                        <div>
                            <span class="sport-breakdown-name"><strong>@sport.Name</strong><small>@sport.GameCount games · @sport.Earnings.ToString("C0")</small></span>
                            <span class="sport-breakdown-bar"><i style="width: @(sport.Percentage)%"></i></span>
                        </div>
                    }
                </div>
            </article>
        </section>


        <section class="report-card report-expenses-card">
            <div class="report-card-header">
                <div><p class="page-kicker">Expenses</p><h2>Recorded spending</h2></div>
                <a class="secondary-btn" href="/expenses">View Expenses</a>
            </div>
            <div class="report-expense-summary">
                <strong class="report-expense-total">@totalExpenses.ToString("C2")</strong>
                <span>@reportExpenses.Count expense records</span>
            </div>
            @if (reportExpenses.Count == 0)
            {
                <p class="owes-empty-state">No expenses in this selection.</p>
            }
            else
            {
                <table class="report-expense-table">
                    <thead><tr><th>Category</th><th>Records</th><th>Amount</th></tr></thead>
                    <tbody>
                        @foreach (var category in expenseSummaries)
                        {
                            <tr><td>@category.Category</td><td>@category.Count</td><td>@category.Amount.ToString("C2")</td></tr>
                        }
                    </tbody>
                </table>
            }
            <p class="report-expense-note">Year reports use expense dates. Season reports include expenses dated within the season's start and end dates.</p>
        </section>

        <section class="report-note">
            <span aria-hidden="true">i</span>
            <div><strong>Keep the books. Stay ready.</strong><p>Blue Ledger keeps your game, expense, and mileage records organized, but it does not provide tax advice. Confirm deductions and reporting requirements with a qualified tax professional.</p></div>
        </section>
    }
</div>

@code {
    private bool isLoading = true;
    private string selectedFilter = "all";
    private List<Game> allGames = [];
    private List<Expense> allExpenses = [];
    private List<Expense> reportExpenses = [];
    private List<ExpenseSummary> expenseSummaries = [];
    private decimal totalExpenses;
    private List<int> years = [];
    private List<Season> seasons = [];
    private int totalGames;
    private int paidGames;
    private int unpaidGames;
    private decimal totalEarnings;
    private decimal paidEarnings;
    private decimal outstandingEarnings;
    private decimal totalMiles;
    private int paidRate;
    private List<SportSummary> sportSummaries = [];
    private string PaidProgressLabel => $"{paidRate:N0} percent of games paid";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            isLoading = false;
            return;
        }

        allGames = await Db.Games
            .Include(x => x.SportType)
            .Where(x => x.UserId == user.Id)
            .ToListAsync();

        allExpenses = await Db.Expenses.AsNoTracking()
            .Where(x => x.UserId == user.Id).ToListAsync();

        years = allGames.Select(x => x.GameDate.Year).Distinct().OrderByDescending(x => x).ToList();
        seasons = await Db.Seasons
            .Where(x => x.UserId == user.Id || x.UserId == null)
            .OrderByDescending(x => x.StartDate)
            .ThenBy(x => x.Name)
            .ToListAsync();

        ApplyFilter();
        isLoading = false;
    }

    private void ApplyFilter()
    {
        var games = ReportGameFilter.Apply(allGames, selectedFilter, seasons.Select(x => x.Id));
        reportExpenses = ReportExpenseFilter.Apply(allExpenses, selectedFilter, seasons);
        totalExpenses = reportExpenses.Sum(x => x.Amount);
        expenseSummaries = reportExpenses.GroupBy(x => x.Category)
            .Select(group => new ExpenseSummary(group.Key, group.Count(), group.Sum(x => x.Amount)))
            .OrderByDescending(x => x.Amount).ThenBy(x => x.Category).ToList();

        totalGames = games.Count;
        paidGames = games.Count(x => x.IsPaid);
        unpaidGames = totalGames - paidGames;
        totalEarnings = games.Sum(x => x.FeeAmount);
        paidEarnings = games.Where(x => x.IsPaid).Sum(x => x.FeeAmount);
        outstandingEarnings = games.Where(x => !x.IsPaid).Sum(x => x.FeeAmount);
        totalMiles = games.Sum(x => x.MilesDriven);
        paidRate = totalGames == 0 ? 0 : (int)Math.Round((decimal)paidGames / totalGames * 100);

        sportSummaries = games
            .GroupBy(x => x.SportType?.Name ?? "Other")
            .Select(group => new SportSummary
            {
                Name = group.Key,
                GameCount = group.Count(),
                Earnings = group.Sum(x => x.FeeAmount),
                Percentage = (int)Math.Round((decimal)group.Count() / totalGames * 100)
            })
            .OrderByDescending(x => x.GameCount)
            .ToList();

    }

    private sealed record ExpenseSummary(string Category, int Count, decimal Amount);

    private sealed class SportSummary
    {
        public string Name { get; set; } = string.Empty;
        public int GameCount { get; set; }
        public decimal Earnings { get; set; }
        public int Percentage { get; set; }
    }
}
