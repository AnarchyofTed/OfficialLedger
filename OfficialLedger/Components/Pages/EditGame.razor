@page "/games/edit/{GameId:int}"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OfficialLedger.Data
@using OfficialLedger.Models

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>Game Details</PageTitle>
<div class="page-content">
    <div class="add-game-page">
    <div class="page-header">
        <div>
            <p class="page-kicker">Assignment record</p>
            <h1 class="page-title">Game Details</h1>
            <p class="page-subtitle">
                @(isEditMode ? "Edit your saved game details." : "View your saved game details.")
            </p>
        </div>
    </div>

    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <div class="validation-summary">@loadError</div>
    }
    else
    {
        <div class="form-card">
            <div class="form-card-heading"><span>@(Input.GameDate?.ToString("dd"))</span><div><h2>@Input.LocationName</h2><p>@(Input.GameDate?.ToString("MMMM d, yyyy"))</p></div></div>
            <EditForm Model="Input" OnValidSubmit="HandleValidSubmit" FormName="editGameForm">
                <DataAnnotationsValidator />
                @if (seasonError is not null)
                {
                    <div class="validation-summary" role="alert">@seasonError</div>
                }

                @if (hasSubmitted && isEditMode)
                {
                    <ValidationSummary class="validation-summary" />
                }

                <div class="form-grid">
                    <div class="form-field">
                        <label for="season">Season *</label>
                        <InputSelect id="season" @bind-Value="Input.SeasonId" class="form-input" disabled="@(!isEditMode)">
                            <option value="">Select season</option>
                            @foreach (var season in seasons)
                            {
                                <option value="@season.Id">@season.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Input.SeasonId" />
                    </div>
                    <div class="form-field">
                        <label for="gameDate">Game Date *</label>
                        <InputDate id="gameDate"
                                   @bind-Value="Input.GameDate"
                                   class="form-input"
                                   disabled="@(!isEditMode)" />
                        <ValidationMessage For="() => Input.GameDate" />
                    </div>

                    <div class="form-field">
                        <label for="sport">Sport</label>
                        <InputSelect id="sport"
                                     @bind-Value="Input.SportTypeId"
                                     class="form-input"
                                     disabled="@(!isEditMode)">
                            <option value="">Select sport</option>
                            @foreach (var sportType in sportTypes)
                            {
                                <option value="@sportType.Id">@sportType.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label for="locationName">Location (optional)</label>
                        <InputText id="locationName"
                                   @bind-Value="Input.LocationName"
                                   class="form-input"
                                   readonly="@(!isEditMode)" />
                    </div>

                    <div class="form-field">
                        <label for="feeAmount">Fee Amount (optional)</label>
                        <InputNumber id="feeAmount" placeholder="0"
                                     @bind-Value="Input.FeeAmount"
                                     class="form-input"
                                     disabled="@(!isEditMode)" />
                    </div>

                    <div class="form-field">
                        <label for="milesDriven">Miles Driven (optional)</label>
                        <InputNumber id="milesDriven" placeholder="0"
                                     @bind-Value="Input.MilesDriven"
                                     class="form-input"
                                     disabled="@(!isEditMode)" />
                    </div>

                    <div class="form-field checkbox-field">
                        <label for="isPaid">Paid</label>
                        <div class="checkbox-row">
                            <InputCheckbox id="isPaid"
                                           @bind-Value="Input.IsPaid"
                                           class="form-checkbox"
                                           disabled="@(!isEditMode)" />
                            <span>Mark as already paid</span>
                        </div>
                    </div>

                    <div class="form-field form-field-full">
                        <label for="notes">Notes</label>
                        <InputTextArea id="notes"
                                       @bind-Value="Input.Notes"
                                       class="form-input form-textarea"
                                       readonly="@(!isEditMode)" />
                    </div>
                </div>

                <div class="form-actions">
                    @if (!isEditMode)
                    {
                        <div class="left-actions">
                            <button type="button" class="primary-btn" @onclick="EnableEditMode">Edit</button>
                            <button type="button" class="secondary-btn" @onclick="GoBack">Back</button>
                        </div>

                       
                        <button type="button" class="danger-btn" @onclick="DeleteGame">Delete</button>
                        
                    }
                    else
                    {   <div class="left-actions">
                            <button type="submit" class="primary-btn" @onclick="MarkSubmitted">Save Changes</button>
                            <button type="button" class="secondary-btn" @onclick="CancelEdit">Cancel</button>
                        </div>
                    }
                </div>
            </EditForm>
        </div>
     }
</div>
</div>

@code {
    [Parameter]
    public int GameId { get; set; }

    private EditGameInputModel Input { get; set; } = new();
    private EditGameInputModel OriginalInput { get; set; } = new();
    private bool isLoading = true;
    private bool hasSubmitted;
    private bool isEditMode;
    private string? loadError;
    private List<SportType> sportTypes = new();
    private List<Season> seasons = new();
    private string? seasonError;

    protected override async Task OnInitializedAsync()
    {
        var user = await GetCurrentUserAsync();

        if (user is null)
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }

        sportTypes = await Db.SportTypes
            .OrderBy(x => x.Name)
            .ToListAsync();

        var game = await Db.Games
            .FirstOrDefaultAsync(x => x.Id == GameId && x.UserId == user.Id);

        if (game is null)
        {
            loadError = "Game not found.";
            isLoading = false;
            return;
        }

        seasons = await Db.Seasons.Where(x => x.UserId == user.Id || x.UserId == null)
            .OrderByDescending(x => x.StartDate).ToListAsync();
        Input = MapFromGame(game);
        OriginalInput = CloneInput(Input);

        isLoading = false;
    }

    private void EnableEditMode()
    {
        isEditMode = true;
        hasSubmitted = false;
    }

    private void MarkSubmitted()
    {
        hasSubmitted = true;
    }

    private async Task HandleValidSubmit()
    {
        if (!isEditMode)
        {
            return;
        }

        var user = await GetCurrentUserAsync();

        if (user is null)
        {
            return;
        }

        var dbGame = await Db.Games
            .FirstOrDefaultAsync(x => x.Id == GameId && x.UserId == user.Id);

        if (dbGame is null)
        {
            loadError = "Game not found.";
            return;
        }

        seasonError = null;
        if (!await Db.Seasons.AnyAsync(x => x.Id == Input.SeasonId && (x.UserId == user.Id || x.UserId == null)))
        {
            seasonError = "Select an available season.";
            return;
        }
        dbGame.SeasonId = Input.SeasonId;
        dbGame.GameDate = Input.GameDate!.Value;
        dbGame.SportTypeId = Input.SportTypeId!.Value;
        dbGame.LocationName = Input.LocationName ?? string.Empty;
        dbGame.FeeAmount = Input.FeeAmount ?? 0m;
        dbGame.MilesDriven = Input.MilesDriven ?? 0m;
        dbGame.IsPaid = Input.IsPaid;
        dbGame.Notes = Input.Notes;

        await Db.SaveChangesAsync();

        OriginalInput = CloneInput(Input);
        isEditMode = false;
        hasSubmitted = false;
        NavigationManager.NavigateTo("/games");
    }

    private void CancelEdit()
    {
        Input = CloneInput(OriginalInput);
        isEditMode = false;
        hasSubmitted = false;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/games");
    }

    private async Task<ApplicationUser?> GetCurrentUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return await UserManager.GetUserAsync(authState.User);
    }

    private static EditGameInputModel MapFromGame(Game game)
    {
        return new EditGameInputModel
        {
            SeasonId = game.SeasonId,
            GameDate = game.GameDate,
            SportTypeId = game.SportTypeId,
            LocationName = game.LocationName,
            FeeAmount = game.FeeAmount,
            MilesDriven = game.MilesDriven,
            IsPaid = game.IsPaid,
            Notes = game.Notes
        };
    }

    private static EditGameInputModel CloneInput(EditGameInputModel input)
    {
        return new EditGameInputModel
        {
            SeasonId = input.SeasonId,
            GameDate = input.GameDate,
            SportTypeId = input.SportTypeId,
            LocationName = input.LocationName,
            FeeAmount = input.FeeAmount,
            MilesDriven = input.MilesDriven,
            IsPaid = input.IsPaid,
            Notes = input.Notes
        };
    }

    public class EditGameInputModel
    {
        [Required(ErrorMessage = "Season is required.")]
        public int? SeasonId { get; set; }

        [Required(ErrorMessage = "Sport is required.")]
        public int? SportTypeId { get; set; }

        public string LocationName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Game date is required.")]
        public DateTime? GameDate { get; set; }

        [Range(0, 10000, ErrorMessage = "Fee amount must be 0 or greater.")]
        public decimal? FeeAmount { get; set; } = 0m;

        [Range(0, 1000, ErrorMessage = "Miles driven must be 0 or greater.")]
        public decimal? MilesDriven { get; set; } = 0m;

        public bool IsPaid { get; set; }

        public string? Notes { get; set; }
    }

    private async Task DeleteGame()
    {    
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this game?");

        if (!confirmed)
        {
            return;
        }

        var user = await GetCurrentUserAsync();

        if (user is null)
        {
            return;
        }

        var dbGame = await Db.Games.FirstOrDefaultAsync(x => x.Id == GameId && x.UserId == user.Id);

        if (dbGame is null)
        {
            loadError = "Game not found.";
            return;
        }

        Db.Games.Remove(dbGame);
        await Db.SaveChangesAsync();

        NavigationManager.NavigateTo("/games");
    }
}

