@page "/games"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OfficialLedger.Data
@using OfficialLedger.Models

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>My Games</PageTitle>
<div class="page-content">
    <div class="page-header">
        <div>
            <p class="page-kicker">Assignment ledger</p>
            <h1 class="page-title">My Games</h1>
            <p class="page-subtitle">Every assignment, payment, and trip in one season-ready record.</p>
        </div>
        <button type="button" class="add-game-btn" @onclick="GoToAddGame">Add Game <span>+</span></button>
    </div>

    @if (games == null)
    {
        <p>Loading...</p>
    }
    else if (!games.Any())
    {
        <div class="empty-state">
            <span class="empty-state-mark" aria-hidden="true">＋</span>
            <h2>Your ledger is ready.</h2>
            <p>Add your first assignment to start tracking earnings, mileage, and payment status.</p>
            <button class="add-game-btn" @onclick="GoToAddGame">Add Your First Game</button>
        </div>
    }
    else
    {
        <div class="games-summary-strip">
            <div><span>Assignments</span><strong>@games.Count</strong></div>
            <div><span>Recorded fees</span><strong>@games.Sum(x => x.FeeAmount).ToString("C0")</strong></div>
            <div><span>Awaiting payment</span><strong>@games.Count(x => !x.IsPaid)</strong></div>
        </div>
        <div class="games-table-card">
            <table class="games-table">
                <thead>
                    <tr><th>Date</th><th>Sport</th><th>Location</th><th>Fee</th><th>Status</th><th aria-label="Open"></th></tr>
                </thead>
                <tbody>
                    @foreach (var game in games)
                    {
                        <tr class="clickable-row" @onclick="() => GoToEditGame(game.Id)">
                            <td data-label="Date"><strong>@game.GameDate.ToString("MMM d")</strong><small>@game.GameDate.Year</small></td>
                            <td data-label="Sport">@game.SportType?.Name</td>
                            <td data-label="Location">@game.LocationName</td>
                            <td data-label="Fee" class="game-fee">@game.FeeAmount.ToString("C")</td>
                            <td data-label="Status"><span class="status-chip @(game.IsPaid ? "paid" : "unpaid")">@(game.IsPaid ? "Paid" : "Unpaid")</span></td>
                            <td class="row-arrow">→</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
@code {
    private List<Game> games = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            return;
        }

        games = await Db.Games
            .Include(x => x.SportType)
            .Where(x => x.UserId == user.Id)
            .OrderByDescending(x => x.GameDate)
            .ToListAsync();
    }

    private void GoToAddGame()
    {
        NavigationManager.NavigateTo("/add-game");
    }

    private void GoToEditGame(int gameId)
    {
        NavigationManager.NavigateTo($"/games/edit/{gameId}");
    }
}
