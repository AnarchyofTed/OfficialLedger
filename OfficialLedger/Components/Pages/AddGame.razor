@page "/add-game"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using OfficialLedger.Data
@using OfficialLedger.Models

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Add Game</PageTitle>
<div class="page-content">
    <div class="add-game-page">
    <div class="page-header">
        <div>
            <p class="page-kicker">New assignment</p>
            <h1 class="page-title">Add Game</h1>
            <p class="page-subtitle">Capture the details now. Your season totals will update automatically.</p>
        </div>
    </div>

    <div class="form-card">
        <div class="form-card-heading"><span>01</span><div><h2>Assignment details</h2><p>Required fields are marked by the form.</p></div></div>
        <EditForm Model="Input" OnValidSubmit="HandleValidSubmit" FormName="addGameForm">
            <DataAnnotationsValidator />
                @if (seasonError is not null)
                {
                    <div class="validation-summary" role="alert">@seasonError</div>
                }

            @if (!string.IsNullOrWhiteSpace(SuccessMessage))
            {
                <div class="alert-success">@SuccessMessage</div>
            }

            @if (hasSubmitted)
            {
                <ValidationSummary class="validation-summary" />
            }

            <div class="form-grid">
                    <div class="form-field">
                        <label for="season">Season *</label>
                        <InputSelect id="season" @bind-Value="Input.SeasonId" class="form-input">
                            <option value="">Select season</option>
                            @foreach (var season in seasons)
                            {
                                <option value="@season.Id">@season.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Input.SeasonId" />
                        <a href="/add-season?returnTo=add-game">+ Add Season</a>
                    </div>
                <div class="form-field">
                    <label for="gameDate">Game Date *</label>
                    <InputDate id="gameDate" @bind-Value="Input.GameDate" class="form-input" />
                        <ValidationMessage For="() => Input.GameDate" />
                </div>

                <div class="form-field">
                    <label for="sport">Sport</label>
                    <InputSelect id="sport" @bind-Value="Input.SportTypeId" class="form-input">
                        <option value="">Select sport</option>
                        @foreach (var sportType in sportTypes)
                        {
                            <option value="@sportType.Id">@sportType.Name</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label for="locationName">Location</label>
                    <InputText id="locationName" @bind-Value="Input.LocationName" class="form-input" />
                </div>

                <div class="form-field">
                    <label for="feeAmount">Fee Amount</label>
                    <InputNumber id="feeAmount" placeholder="0" @bind-Value="Input.FeeAmount" class="form-input" />
                </div>

                <div class="form-field">
                    <label for="milesDriven">Miles Driven</label>
                    <InputNumber id="milesDriven" placeholder="0" @bind-Value="Input.MilesDriven" class="form-input" />
                </div>

                <div class="form-field checkbox-field">
                    <label for="isPaid">Paid in full</label>
                    <div class="checkbox-row">
                        <InputCheckbox id="isPaid" @bind-Value="Input.IsPaid" class="form-checkbox" />
                        <span>Mark full fee as received</span>
                    </div>
                </div>

                <div class="form-field form-field-full">
                    <label for="notes">Notes</label>
                    <InputTextArea id="notes" @bind-Value="Input.Notes" class="form-input form-textarea" />
                </div>
                <GameTaxFields Model="Input" />
            </div>

            <div class="form-actions">
                <button type="submit" disabled="@(!seasons.Any())" class="primary-btn" @onclick="MarkSubmitted">Save Game</button>
                <button type="button" class="secondary-btn" @onclick="Cancel">Cancel</button>
            </div>
        </EditForm>
    </div>
</div>
</div>
@code {
    private AddGameInputModel Input { get; set; } = new()
    {
        GameDate = DateTime.Today
    };

    private string? SuccessMessage;
    private bool hasSubmitted;
    private List<SportType> sportTypes = new();
    private List<Season> seasons = new();
    private string? seasonError;

    [SupplyParameterFromQuery]
    public int? SeasonId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user is null) return;
        seasons = await Db.Seasons.Where(x => x.UserId == user.Id || x.UserId == null)
            .OrderByDescending(x => x.StartDate).ToListAsync();
        if (seasons.Any(x => x.Id == SeasonId)) Input.SeasonId = SeasonId;
        sportTypes = await Db.SportTypes
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private void MarkSubmitted()
    {
        hasSubmitted = true;
    }

    private async Task HandleValidSubmit()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            return;
        }

        seasonError = null;
        if (!await Db.Seasons.AnyAsync(x => x.Id == Input.SeasonId && (x.UserId == user.Id || x.UserId == null)))
        {
            seasonError = "Select an available season.";
            return;
        }

        var game = new Game
        {
            UserId = user.Id,
            SeasonId = Input.SeasonId,
            GameDate = Input.GameDate!.Value,
            SportTypeId = Input.SportTypeId!.Value,
            LocationName = Input.LocationName ?? string.Empty,
            FeeAmount = Input.FeeAmount ?? 0m,
            MilesDriven = Input.MilesDriven ?? 0m,
            IsPaid = Input.IsPaid,
            Notes = Input.Notes
        };

        Input.ApplyTaxFields(game);
        Db.Games.Add(game);
        await Db.SaveChangesAsync();

        SuccessMessage = "Game saved successfully.";

        Input = new AddGameInputModel
        {
            GameDate = DateTime.Today
        };

        hasSubmitted = false;

        NavigationManager.NavigateTo("/games");
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/games");
    }

    public class AddGameInputModel : GameTaxInputModel
    {
        [Required(ErrorMessage = "Season is required.")]
        public int? SeasonId { get; set; }

        [Required(ErrorMessage = "Sport is required.")]
        public int? SportTypeId { get; set; }

        public string LocationName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Game date is required.")]
        public DateTime? GameDate { get; set; }

        [Range(0, 10000, ErrorMessage = "Fee amount must be 0 or greater.")]
        public decimal? FeeAmount { get; set; } = 0m;

        [Range(0, 1000, ErrorMessage = "Miles driven must be 0 or greater.")]
        public decimal? MilesDriven { get; set; } = 0m;

        public string? Notes { get; set; }
    }
}

