@page "/expenses/details/{ExpenseId:int}"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OfficialLedger.Data
@using OfficialLedger.Models
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ILogger<ExpenseDetails> Logger

<PageTitle>Expense Details | Blue Ledger</PageTitle>
<div class="page-content">
    <div class="add-game-page">
        <header class="page-header">
            <div><p class="page-kicker">Expense record</p><h1 class="page-title">Expense Details</h1>
                <p class="page-subtitle">@(editing ? "Edit your saved expense details." : "View your saved expense details.")</p></div>
        </header>
        @if (loading)
        {
            <div class="loading-card">Loading expense...</div>
        }
        else if (!found)
        {
            <div class="empty-state"><h2>Expense not found.</h2><a class="secondary-btn" href="/expenses">Back to Expenses</a></div>
        }
        else
        {
            <section class="form-card">
                <div class="form-card-heading"><span>@(Input.ExpenseDate?.ToString("dd"))</span>
                    <div><h2>@Input.Category</h2><p>@(Input.ExpenseDate?.ToString("MMMM d, yyyy"))</p></div></div>
                @if (error is not null)
                {
                    <div class="validation-summary" role="alert">@error</div>
                }
                <EditForm Model="Input" OnValidSubmit="SaveChanges" FormName="expenseDetailsForm">
                    <DataAnnotationsValidator />
                    @if (editing) { <ValidationSummary class="validation-summary" /> }
                <div class="form-grid">
                    <div class="form-field"><label for="expenseDate">Date *</label>
                        <InputDate disabled="@(!editing || busy)" id="expenseDate" @bind-Value="Input.ExpenseDate" class="form-input" />
                        <ValidationMessage For="() => Input.ExpenseDate" /></div>
                    <div class="form-field"><label for="expenseCategory">Category *</label>
                        <InputSelect disabled="@(!editing || busy)" id="expenseCategory" @bind-Value="Input.Category" class="form-input">
                            @foreach (var category in ExpenseInputModel.Categories)
                            {
                                <option value="@category">@category</option>
                            }
                        </InputSelect></div>
                    <div class="form-field"><label for="expenseAmount">Amount *</label>
                        <InputNumber disabled="@(!editing || busy)" id="expenseAmount" @bind-Value="Input.Amount" class="form-input" min="0.01" step="0.01" placeholder="0.00" />
                        <ValidationMessage For="() => Input.Amount" /></div>
                    <div class="form-field"><label for="expenseVendor">Paid To</label>
                        <InputText readonly="@(!editing || busy)" id="expenseVendor" @bind-Value="Input.Vendor" class="form-input" maxlength="200" placeholder="Amazon, Academy, or camp name" /></div>
                    <div class="form-field form-field-full"><label for="expensePurpose">Description</label>
                        <InputText readonly="@(!editing || busy)" id="expensePurpose" @bind-Value="Input.BusinessPurpose" class="form-input" maxlength="500" placeholder="Example: Registration for umpire training camp" /></div>
                    <div class="form-field form-field-full"><label for="expenseNotes">Notes</label>
                        <InputTextArea readonly="@(!editing || busy)" id="expenseNotes" @bind-Value="Input.Notes" class="form-input form-textarea" maxlength="2000" /></div>
                </div>

                    <div class="form-actions">
                        @if (!editing)
                        {
                            <div class="left-actions">
                                <button type="button" class="primary-btn" disabled="@busy" @onclick="EnableEdit">Edit</button>
                                <a class="secondary-btn" href="/expenses">Back</a>
                            </div>
                            <button type="button" class="danger-btn" disabled="@busy" @onclick="DeleteExpense">Delete</button>
                        }
                        else
                        {
                            <div class="left-actions">
                                <button type="submit" class="primary-btn" disabled="@busy">@(busy ? "Saving…" : "Save Changes")</button>
                                <button type="button" class="secondary-btn" disabled="@busy" @onclick="CancelEdit">Cancel</button>
                            </div>
                        }
                    </div>
                </EditForm>
            </section>
        }
    </div>
</div>

@code {
    [Parameter] public int ExpenseId { get; set; }
    private ExpenseInputModel Input { get; set; } = new();
    private ExpenseInputModel original = new();
    private bool loading = true;
    private bool found;
    private bool editing;
    private bool busy;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        found = false;
        editing = false;
        error = null;
        var userId = await CurrentUserId();
        if (string.IsNullOrWhiteSpace(userId))
        {
            NavigationManager.NavigateTo("/Account/Login");
            return;
        }
        var record = await Db.Expenses.AsNoTracking().FirstOrDefaultAsync(x => x.Id == ExpenseId && x.UserId == userId);
        if (record is not null)
        {
            Input = new()
            {
                ExpenseDate = record.ExpenseDate, Category = record.Category, Amount = record.Amount,
                Vendor = record.Vendor, BusinessPurpose = record.BusinessPurpose, Notes = record.Notes
            };
            original = Copy(Input);
            found = true;
        }
        loading = false;
    }

    private async Task<string?> CurrentUserId()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return auth.User.Identity?.IsAuthenticated == true ? auth.User.FindFirstValue(ClaimTypes.NameIdentifier) : null;
    }

    private static ExpenseInputModel Copy(ExpenseInputModel input) => new()
    {
        ExpenseDate = input.ExpenseDate, Category = input.Category, Amount = input.Amount,
        Vendor = input.Vendor, BusinessPurpose = input.BusinessPurpose, Notes = input.Notes
    };

    private void EnableEdit() { if (busy) return; editing = true; error = null; }
    private void CancelEdit() { Input = Copy(original); editing = false; error = null; }

    private async Task SaveChanges()
    {
        if (!editing || busy) return;
        busy = true;
        error = null;
        Expense? record = null;
        try
        {
            var userId = await CurrentUserId();
            if (string.IsNullOrWhiteSpace(userId)) { NavigationManager.NavigateTo("/Account/Login"); return; }
            record = await Db.Expenses.FirstOrDefaultAsync(x => x.Id == ExpenseId && x.UserId == userId);
            if (record is null) { found = false; return; }
            record.ExpenseDate = Input.ExpenseDate!.Value.Date;
            record.Category = Input.Category;
            record.Amount = Input.Amount!.Value;
            record.Vendor = Input.Vendor?.Trim();
            record.BusinessPurpose = Input.BusinessPurpose?.Trim();
            record.Notes = Input.Notes?.Trim();
            await Db.SaveChangesAsync();
            original = Copy(Input);
            editing = false;
            NavigationManager.NavigateTo("/expenses");
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Could not update expense.");
            error = "The expense could not be saved. Please try again.";
        }
        finally
        {
            if (record is not null) Db.Entry(record).State = EntityState.Detached;
            busy = false;
        }
    }

    private async Task DeleteExpense()
    {
        if (busy || !await JS.InvokeAsync<bool>("confirm", "Delete this expense?")) return;
        if (busy) return;
        busy = true;
        error = null;
        Expense? record = null;
        try
        {
            var userId = await CurrentUserId();
            if (string.IsNullOrWhiteSpace(userId)) { NavigationManager.NavigateTo("/Account/Login"); return; }
            record = await Db.Expenses.FirstOrDefaultAsync(x => x.Id == ExpenseId && x.UserId == userId);
            if (record is null) { found = false; return; }
            Db.Expenses.Remove(record);
            await Db.SaveChangesAsync();
            NavigationManager.NavigateTo("/expenses");
        }
        catch (DbUpdateException ex)
        {
            Logger.LogError(ex, "Could not delete expense.");
            error = "The expense could not be deleted. Please try again.";
        }
        finally
        {
            if (record is not null) Db.Entry(record).State = EntityState.Detached;
            busy = false;
        }
    }
}
