@page "/add-season"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OfficialLedger.Data
@using OfficialLedger.Models
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<AddSeason> Logger

<PageTitle>Add Season</PageTitle>
<div class="page-content">
    <div class="add-game-page">
        <div class="page-header">
            <div><p class="page-kicker">Your next season</p><h1 class="page-title">Add Season</h1>
                <p class="page-subtitle">Choose a name, date range, and sport image for your season.</p></div>
        </div>
        <div class="form-card">
            <EditForm Model="Input" OnValidSubmit="SaveSeason" FormName="addSeasonForm">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />
                @if (error is not null)
                {
                    <div class="validation-summary" role="alert">@error</div>
                }
                <div class="form-grid">
                    <div class="form-field form-field-full">
                        <label for="seasonName">Season name</label>
                        <InputText id="seasonName" @bind-Value="Input.Name" class="form-input" placeholder="2027 Baseball Season" maxlength="100" />
                    </div>
                    <div class="form-field">
                        <label for="startDate">Start date</label>
                        <InputDate id="startDate" @bind-Value="Input.StartDate" class="form-input" />
                    </div>
                    <div class="form-field">
                        <label for="endDate">End date</label>
                        <InputDate id="endDate" @bind-Value="Input.EndDate" class="form-input" />
                    </div>
                    <fieldset class="form-field form-field-full season-image-fieldset">
                        <legend>Sport image</legend>
                        <InputRadioGroup @bind-Value="Input.SportImage">
                            <div class="season-image-grid">
                            @foreach (var sport in SeasonImages.Options)
                            {
                                <label class="season-image-choice @(Input.SportImage == sport.Key ? "selected" : "")">
                                    <InputRadio Value="@sport.Key" />
                                    <img src="@SeasonImages.Path(sport.Key)" alt="" />
                                    <span>@sport.Label</span>
                                </label>
                            }
                            </div>
                        </InputRadioGroup>
                    </fieldset>
                </div>
                <div class="form-actions">
                    <button type="submit" class="primary-btn" disabled="@saving">@(saving ? "Saving…" : "Create Season")</button>
                    <button type="button" class="secondary-btn" disabled="@saving" @onclick="Cancel">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnTo { get; set; }
    private SeasonInputModel Input { get; set; } = new();
    private bool saving;
    private string? error;

    private async Task SaveSeason()
    {
        if (saving) return;
        saving = true;
        error = null;
        Season? season = null;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                NavigationManager.NavigateTo("/Account/Login");
                return;
            }
            season = new Season
            {
                UserId = userId,
                Name = Input.Name.Trim(),
                StartDate = Input.StartDate!.Value.Date,
                EndDate = Input.EndDate!.Value.Date,
                SportImage = Input.SportImage
            };
            Db.Seasons.Add(season);
            await Db.SaveChangesAsync();
            NavigationManager.NavigateTo(ReturnTo == "add-game"
                ? $"/add-game?seasonId={season.Id}" : $"/dashboard?seasonId={season.Id}");
        }
        catch (DbUpdateException ex)
        {
            if (season is not null) Db.Entry(season).State = EntityState.Detached;
            Logger.LogError(ex, "Could not create season.");
            error = "The season could not be saved. Please try again.";
        }
        finally { saving = false; }
    }

    private void Cancel() => NavigationManager.NavigateTo(ReturnTo == "add-game" ? "/add-game" : "/dashboard");

    public class SeasonInputModel : IValidatableObject
    {
        [Required, StringLength(100)] public string Name { get; set; } = string.Empty;
        [Required] public DateTime? StartDate { get; set; } = DateTime.Today;
        [Required] public DateTime? EndDate { get; set; } = new DateTime(DateTime.Today.Year, 12, 31);
        [Required] public string SportImage { get; set; } = "baseball";

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.IsNullOrWhiteSpace(Name))
                yield return new ValidationResult("Enter a season name.", new[] { nameof(Name) });
            if (StartDate.HasValue && EndDate.HasValue && EndDate.Value.Date < StartDate.Value.Date)
                yield return new ValidationResult("End date must be on or after the start date.", new[] { nameof(EndDate) });
            if (!SeasonImages.Options.Any(x => x.Key == SportImage))
                yield return new ValidationResult("Choose an available sport image.", new[] { nameof(SportImage) });
        }
    }
}
