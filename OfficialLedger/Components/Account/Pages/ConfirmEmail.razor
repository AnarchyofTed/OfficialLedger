@page "/Account/ConfirmEmail"

@using Microsoft.AspNetCore.Identity
@using OfficialLedger.Data

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

<PageTitle>Confirm email | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">Email verification</p>
        <h1>@(confirmed ? "You're ready to go." : "That link didn't work.")</h1>
        <p>@(confirmed ? "Your email is confirmed. Log in to start using your ledger." : "This confirmation link is invalid or has expired. Request a new email to continue.")</p>
    </div>
    <a class="ol-button ol-button-blue auth-submit" href="@(confirmed ? LoginUrl : "Account/ResendEmailConfirmation")">@(confirmed ? "Log in" : "Send a new link") <span>↗</span></a>
</section>

@code {
    private bool confirmed;

    [SupplyParameterFromQuery] private string? UserId { get; set; }
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string LoginUrl => NavigationManager.GetUriWithQueryParameters("Account/Login",
        new Dictionary<string, object?> { ["returnUrl"] = AccountEmailService.SafeReturnUrl(ReturnUrl) });

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(UserId) || !AccountEmailService.TryDecodeToken(Code, out var token)) return;
        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null) return;
        confirmed = (await UserManager.ConfirmEmailAsync(user, token)).Succeeded;
    }
}
