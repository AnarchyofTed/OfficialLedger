@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">Account recovery</p>
        <h1>Check your inbox.</h1>
        <p>If this address belongs to a confirmed BlueLedger account with a password, look for an email with a reset link.</p>
    </div>
    <p class="auth-note">The link expires in 1 hour. Check your spam folder if you do not see it, then try again if needed.</p>
    <a class="ol-button ol-button-blue auth-submit" href="Account/Login">Back to log in <span>↗</span></a>
    <p class="auth-switch"><a href="Account/ForgotPassword">Request another reset link</a> · <a href="Account/ResendEmailConfirmation">Confirm your email</a></p>
</section>
