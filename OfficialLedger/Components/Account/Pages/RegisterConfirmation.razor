@page "/Account/RegisterConfirmation"

<PageTitle>Confirm your email | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">One last step</p>
        <h1>Check your inbox.</h1>
        <p>Open your BlueLedger confirmation email and select Confirm email to activate your account.</p>
    </div>
    <StatusMessage />
    <p class="auth-note">The link expires in 24 hours. If the email has not arrived, check your spam folder or request another link.</p>
    <a class="ol-button ol-button-blue auth-submit" href="Account/ResendEmailConfirmation">Resend confirmation <span>↗</span></a>
    <p class="auth-switch">Already confirmed? <a href="Account/Login">Log in</a></p>
</section>
