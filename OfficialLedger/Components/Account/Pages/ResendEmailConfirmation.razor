@page "/Account/ResendEmailConfirmation"

@using System.ComponentModel.DataAnnotations

@inject AccountEmailService AccountEmail

<PageTitle>Resend confirmation | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">Email verification</p>
        <h1>Need a new link?</h1>
        <p>Enter your account email to request another confirmation email.</p>
    </div>
    <StatusMessage Message="@message" />
    <EditForm Model="Input" FormName="resend-email-confirmation" OnValidSubmit="OnValidSubmitAsync" method="post" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" role="alert" />
        <div class="auth-field">
            <label for="resend-email">Email address</label>
            <InputText id="resend-email" type="email" @bind-Value="Input.Email" class="auth-input" autocomplete="email" aria-required="true" placeholder="you@example.com" maxlength="256" />
            <ValidationMessage For="() => Input.Email" class="field-validation" />
        </div>
        <button type="submit" class="ol-button ol-button-blue auth-submit">Resend confirmation <span>↗</span></button>
        <p class="auth-note">Confirmation links expire in 24 hours. Check your spam folder if you do not see the email.</p>
        <p class="auth-switch"><a href="Account/Login">Back to log in</a></p>
    </EditForm>
</section>

@code {
    private string? message;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        await AccountEmail.RequestConfirmationAsync(Input.Email);
        message = "If this address belongs to an account awaiting confirmation, check your inbox for a confirmation link.";
    }

    private sealed class InputModel
    {
        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";
    }
}
