@page "/Account/InvalidPasswordReset"

<PageTitle>Reset link expired | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">Account recovery</p>
        <h1>Let's get a fresh link.</h1>
        <p>This password reset link is invalid, expired or has already been used.</p>
    </div>
    <a class="ol-button ol-button-blue auth-submit" href="Account/ForgotPassword">Request a new link <span>↗</span></a>
    <p class="auth-switch"><a href="Account/Login">Back to log in</a></p>
</section>
