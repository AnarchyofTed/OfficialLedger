@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Json
@using System.Security.Cryptography
@using Microsoft.AspNetCore.DataProtection
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using OfficialLedger.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject IDataProtectionProvider DataProtection
@inject IConfiguration Configuration
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">@SelectedPlanLabel</p>
        <h1>@(Input.PaymentStep && IsProPlan ? "Your Pro account awaits." : Input.DetailsStep ? "Finish your signup." : "Create your ledger.")</h1>
        <p>@(Input.PaymentStep && IsProPlan ? "Step 3 of 3: payment details." : Input.DetailsStep ? (IsProPlan ? "Step 2 of 3: tell us a little about yourself." : "Step 2 of 2: tell us a little about yourself.") : (IsProPlan ? "Step 1 of 3: start with your email address." : "Step 1 of 2: start with your email address."))</p>
    </div>
    <StatusMessage Message="@(signupError ?? Message)" />
    <EditForm Model="Input" asp-route-returnUrl="@ReturnUrl" asp-route-plan="@Plan" method="post" OnValidSubmit="RegisterUser" FormName="register" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" role="alert" />
        <input type="hidden" name="Input.DetailsStep" value="@Input.DetailsStep.ToString()" />
        <input type="hidden" name="Input.PaymentStep" value="@Input.PaymentStep.ToString()" />
        @if (!Input.DetailsStep)
        {
            <div class="auth-field">
                <label for="register-email">Email address</label>
                <InputText id="register-email" type="email" @bind-Value="Input.Email" class="auth-input" autocomplete="email" aria-required="true" placeholder="you@example.com" maxlength="256" />
                <ValidationMessage For="() => Input.Email" class="field-validation" />
            </div>
            <button type="submit" class="ol-button ol-button-blue auth-submit">Sign Up <span>↗</span></button>
        }
        else if (Input.PaymentStep && IsProPlan)
        {
            <input type="hidden" name="Input.Email" value="@Input.Email" />
            <input type="hidden" name="Input.ProtectedDetails" value="@Input.ProtectedDetails" />

            <div class="beta-payment-intro">
                <strong>Pro plan — $39/year</strong>
                <span>Free during beta</span>
            </div>
            <p class="beta-payment-message" id="beta-payment-message">
                @if (IsBetaMode)
                {
                    <text>Payment is disabled during our beta. No credit card is needed and you will not be charged. Your account will be created with Pro access.</text>
                }
                else
                {
                    <text>Pro checkout is not available yet. A secure payment provider must be connected before paid signups can be accepted.</text>
                }
            </p>
            <fieldset class="beta-payment-fields" disabled aria-describedby="beta-payment-message">
                <legend>Payment information</legend>
                <div class="auth-field">
                    <label for="pro-card-name">Name on card</label>
                    <input id="pro-card-name" class="auth-input" type="text" placeholder="Cardholder name" autocomplete="off" disabled />
                </div>
                <div class="auth-field">
                    <label for="pro-card-number">Card number</label>
                    <input id="pro-card-number" class="auth-input" type="text" placeholder="•••• •••• •••• ••••" autocomplete="off" disabled />
                </div>
                <div class="beta-payment-row">
                    <div class="auth-field">
                        <label for="pro-expiration">Expiration</label>
                        <input id="pro-expiration" class="auth-input" type="text" placeholder="MM / YY" autocomplete="off" disabled />
                    </div>
                    <div class="auth-field">
                        <label for="pro-cvc">Security code</label>
                        <input id="pro-cvc" class="auth-input" type="text" placeholder="CVC" autocomplete="off" disabled />
                    </div>
                </div>
            </fieldset>
            @if (IsBetaMode)
            {
                <button type="submit" class="ol-button ol-button-blue auth-submit">Create Pro Account <span>↗</span></button>
                <p class="auth-note">Your Pro access is free during beta. We will ask you to choose a paid plan before any future billing.</p>
            }
            else
            {
                <button type="button" class="ol-button ol-button-blue auth-submit" disabled>Secure checkout required</button>
            }
            <p class="auth-note">Signing up as @Input.Email · <a href="@NavigationManager.Uri" data-enhance-nav="false">Start over</a></p>
        }
        else
        {
            <input type="hidden" name="Input.Email" value="@Input.Email" />
            <p class="auth-note">Signing up as @Input.Email · <a href="@NavigationManager.Uri" data-enhance-nav="false">Change email</a></p>
            <div class="auth-field">
                <label for="register-first-name">First name</label>
                <InputText id="register-first-name" @bind-Value="Input.FirstName" class="auth-input" autocomplete="given-name" aria-required="true" maxlength="100" />
                <ValidationMessage For="() => Input.FirstName" class="field-validation" />
            </div>
            <div class="auth-field">
                <label for="register-last-name">Last name</label>
                <InputText id="register-last-name" @bind-Value="Input.LastName" class="auth-input" autocomplete="family-name" aria-required="true" maxlength="100" />
                <ValidationMessage For="() => Input.LastName" class="field-validation" />
            </div>
            <div class="auth-field">
                <label for="register-phone">Phone number</label>
                <InputText id="register-phone" type="tel" @bind-Value="Input.PhoneNumber" class="auth-input" autocomplete="tel" aria-required="true" maxlength="32" />
                <ValidationMessage For="() => Input.PhoneNumber" class="field-validation" />
            </div>
            <div class="auth-field">
                <label for="register-address">Address</label>
                <InputTextArea id="register-address" @bind-Value="Input.Address" class="auth-input" autocomplete="street-address" maxlength="500" rows="3" />
                <ValidationMessage For="() => Input.Address" class="field-validation" />
            </div>
            <div class="auth-field">
                <label for="register-password">Password</label>
                <InputText id="register-password" type="password" @bind-Value="Input.Password" class="auth-input" autocomplete="new-password" aria-required="true" placeholder="At least 6 characters" maxlength="100" />
                <ValidationMessage For="() => Input.Password" class="field-validation" />
            </div>
            <div class="auth-field">
                <label for="register-confirm">Confirm password</label>
                <InputText id="register-confirm" type="password" @bind-Value="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" aria-required="true" maxlength="100" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="field-validation" />
            </div>
            <button type="submit" class="ol-button ol-button-blue auth-submit">@(IsProPlan ? "Continue to payment" : "Create Free Account") <span>↗</span></button>
        }
        <p class="auth-note">By continuing, you agree to keep the game moving.</p>
        <p class="auth-switch">Already have an account? <a href="/Account/Login">Log in</a></p>
    </EditForm>
</section>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private string? signupError;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Plan { get; set; }

    private bool IsProPlan => string.Equals(Plan, "Pro", StringComparison.OrdinalIgnoreCase);
    private bool IsBetaMode => Configuration.GetValue<bool>("Billing:BetaMode");
    private string SelectedPlanLabel => IsProPlan ? "Pro plan" : "Free plan";
    private ITimeLimitedDataProtector RegistrationProtector =>
        DataProtection.CreateProtector("BlueLedger.Registration.ProDetails.v1").ToTimeLimitedDataProtector();

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";

    public async Task RegisterUser(EditContext editContext)
    {
        signupError = null;
        Input.Email = Input.Email.Trim();
        if (!Input.DetailsStep)
        {
            var normalizedEmail = UserManager.NormalizeEmail(Input.Email) ?? Input.Email.ToUpperInvariant();
            SignupEmail? entry = null;
            try
            {
                if (!await Db.SignupEmails.AnyAsync(x => x.NormalizedEmail == normalizedEmail))
                {
                    entry = new SignupEmail { Email = Input.Email, NormalizedEmail = normalizedEmail, CreatedAtUtc = DateTime.UtcNow };
                    Db.SignupEmails.Add(entry);
                    await Db.SaveChangesAsync();
                }
            }
            catch (DbUpdateException ex) when (ex.InnerException is Microsoft.Data.SqlClient.SqlException { Number: 2601 or 2627 })
            {
                // Another request has already stored this normalized email.
                if (entry is not null) Db.Entry(entry).State = EntityState.Detached;
            }
            catch (Exception ex) when (ex is DbUpdateException or Microsoft.Data.SqlClient.SqlException)
            {
                if (entry is not null) Db.Entry(entry).State = EntityState.Detached;
                Logger.LogError(ex, "Could not save signup email.");
                signupError = "Error: We could not save your signup. Please try again.";
                return;
            }
            Input.DetailsStep = true;
            return;
        }

        if (Input.PaymentStep && !IsProPlan)
        {
            signupError = "Error: Restart signup to choose a plan.";
            return;
        }

        PendingRegistration? pending = null;
        if (IsProPlan && !Input.PaymentStep)
        {
            // Preserve the password only in a time-limited, encrypted/authenticated payload.
            // Never put raw password or credit-card data in hidden HTML form inputs.
            pending = new PendingRegistration(Input.Email, Input.FirstName, Input.LastName,
                Input.PhoneNumber, Input.Address, Input.Password);
            Input.ProtectedDetails = RegistrationProtector.Protect(
                JsonSerializer.Serialize(pending), TimeSpan.FromMinutes(20));
            Input.Password = "";
            Input.ConfirmPassword = "";
            Input.PaymentStep = true;
            return;
        }

        if (IsProPlan)
        {
            // Fail closed when beta is disabled. Paid checkout must use a PCI-compliant
            // hosted checkout/provider token, not card fields posted to our server.
            if (!IsBetaMode)
            {
                signupError = "Pro registration requires secure checkout, which is not yet available.";
                return;
            }

            try
            {
                pending = JsonSerializer.Deserialize<PendingRegistration>(
                    RegistrationProtector.Unprotect(Input.ProtectedDetails ?? ""));
            }
            catch (Exception ex) when (ex is CryptographicException or JsonException or FormatException or ArgumentException)
            {
                signupError = "Your signup session expired. Please restart registration.";
                return;
            }

            if (pending is null || !string.Equals(pending.Email, Input.Email, StringComparison.OrdinalIgnoreCase))
            {
                signupError = "Your signup session could not be verified. Please restart registration.";
                return;
            }
        }

        var user = CreateUser();
        user.FirstName = (pending?.FirstName ?? Input.FirstName).Trim();
        user.LastName = (pending?.LastName ?? Input.LastName).Trim();
        user.PhoneNumber = (pending?.PhoneNumber ?? Input.PhoneNumber).Trim();
        var address = pending?.Address ?? Input.Address;
        user.Address = string.IsNullOrWhiteSpace(address) ? null : address.Trim();
        user.Plan = IsProPlan ? "Pro" : "Free";
        user.IsBetaProAccount = IsProPlan && IsBetaMode;

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);
        var emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);
        var result = await UserManager.CreateAsync(user, pending?.Password ?? Input.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User created a new account with password.");

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code, ["returnUrl"] = ReturnUrl });

        await EmailSender.SendConfirmationLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        if (UserManager.Options.SignIn.RequireConfirmedAccount)
        {
            RedirectManager.RedirectTo(
                "Account/RegisterConfirmation",
                new() { ["email"] = Input.Email, ["returnUrl"] = ReturnUrl });
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl ?? "/dashboard");
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException($"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException("The default UI requires a user store with email support.");
        }
        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed record PendingRegistration(string Email, string FirstName, string LastName,
        string PhoneNumber, string? Address, string Password);

    public sealed class InputModel : IValidatableObject
    {
        public bool DetailsStep { get; set; }
        public bool PaymentStep { get; set; }
        public string? ProtectedDetails { get; set; }

        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";

        [StringLength(100)] public string FirstName { get; set; } = "";
        [StringLength(100)] public string LastName { get; set; } = "";
        [StringLength(32)] public string PhoneNumber { get; set; } = "";
        [StringLength(500)] public string? Address { get; set; }
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!DetailsStep) yield break;
            if (PaymentStep)
            {
                if (string.IsNullOrWhiteSpace(ProtectedDetails))
                    yield return new ValidationResult("Your signup session expired. Restart registration.", new[] { nameof(ProtectedDetails) });
                yield break;
            }
            if (string.IsNullOrWhiteSpace(FirstName))
                yield return new ValidationResult("Enter your first name.", new[] { nameof(FirstName) });
            if (string.IsNullOrWhiteSpace(LastName))
                yield return new ValidationResult("Enter your last name.", new[] { nameof(LastName) });
            if (string.IsNullOrWhiteSpace(PhoneNumber) || !new PhoneAttribute().IsValid(PhoneNumber))
                yield return new ValidationResult("Enter a valid phone number.", new[] { nameof(PhoneNumber) });
            if (string.IsNullOrWhiteSpace(Password) || Password.Length < 6 || Password.Length > 100)
                yield return new ValidationResult("Password must be between 6 and 100 characters.", new[] { nameof(Password) });
            if (string.IsNullOrEmpty(ConfirmPassword) || Password != ConfirmPassword)
                yield return new ValidationResult("The password and confirmation password do not match.", new[] { nameof(ConfirmPassword) });
        }
    }
}
