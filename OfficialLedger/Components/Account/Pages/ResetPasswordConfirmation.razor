@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">Account recovery</p>
        <h1>Password updated.</h1>
        <p>Your new password is ready. Log in to continue.</p>
    </div>
    <a class="ol-button ol-button-blue auth-submit" href="Account/Login">Log in <span>↗</span></a>
</section>
