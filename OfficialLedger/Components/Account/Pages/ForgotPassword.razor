@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations

@inject AccountEmailService AccountEmail
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot password | BlueLedger</PageTitle>

<section class="auth-card">
    <div class="auth-card-heading">
        <p class="page-kicker">Account recovery</p>
        <h1>Forgot your password?</h1>
        <p>Enter your account email to request a password reset link.</p>
    </div>
    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post" class="auth-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-summary" role="alert" />
        <div class="auth-field">
            <label for="forgot-email">Email address</label>
            <InputText id="forgot-email" type="email" @bind-Value="Input.Email" class="auth-input" autocomplete="email" aria-required="true" placeholder="you@example.com" maxlength="256" />
            <ValidationMessage For="() => Input.Email" class="field-validation" />
        </div>
        <button type="submit" class="ol-button ol-button-blue auth-submit">Send reset link <span>↗</span></button>
        <p class="auth-note">Your email must be confirmed before you can reset your password. <a href="Account/ResendEmailConfirmation">Resend confirmation</a></p>
        <p class="auth-switch"><a href="Account/Login">Back to log in</a></p>
    </EditForm>
</section>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private async Task OnValidSubmitAsync()
    {
        await AccountEmail.RequestPasswordResetAsync(Input.Email);
        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required, EmailAddress, StringLength(256)]
        public string Email { get; set; } = "";
    }
}
