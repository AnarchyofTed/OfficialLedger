@inherits LayoutComponentBase

<div class="page-shell">
    <header class="topbar">
        <div class="topbar-left">
            <a href="/" class="brand">
                <span class="brand-icon">◔</span>
                <span class="brand-text">OfficialLedger</span>
            </a>
        </div>

        <nav class="topbar-nav">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link">
                Dashboard
            </NavLink>
            <NavLink href="/games" class="nav-link">
                My Games
            </NavLink>
            <NavLink href="/reports" class="nav-link">
                Reports
            </NavLink>
        </nav>

        <div class="topbar-right">
            <AuthorizeView>
                <Authorized>
                    <div class="user-pill">
                        <span class="user-avatar">👤</span>
                        <a href="/Account/Manage" class="user-link">@context.User.Identity?.Name</a>
                    </div>

                    <form method="post" action="/Account/Logout" @formname="logoutForm">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="" />
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/Account/Login" class="user-link">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>
</div>